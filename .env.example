# Copy this file to .env and adjust values as needed.
# Each variable overrides the corresponding default in config.py.

# Name of the S3 Vectors bucket that holds the vector index.
VECTOR_BUCKET_NAME=sample-rag-vectors

# Name of the vector index within the bucket.
INDEX_NAME=rag-documents

# Bedrock model id for embeddings (Amazon Titan Text Embeddings v2).
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Bedrock model id for answer generation, called through the Converse API.
GENERATION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# AWS region for Bedrock and S3 Vectors.
AWS_REGION=us-east-1

# Number of most-similar chunks to retrieve per query.
TOP_K=5
